# ─── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8402
LOG_LEVEL=debug

# Public HTTPS base URL once deployed. Used to build verification links.
PUBLIC_BASE_URL=http://localhost:8402

# ─── Algorand ─────────────────────────────────────────────────────────────
# "testnet" while building, "mainnet" for the competition entry.
# Switching this also switches the USDC asset id and the beacon app id.
ALGORAND_NETWORK=testnet

# Optional overrides — sensible public defaults are used when unset.
# ALGOD_URL=
# ALGOD_TOKEN=
# INDEXER_URL=
# BEACON_APP_ID=

# ─── Payments (x402) ──────────────────────────────────────────────────────
# Address that receives every payment. Must be opted in to USDC
# (ASA 10458941 on TestNet, 31566704 on MainNet).
# Keep the SAME address for the whole competition: the leaderboard keys your
# Composite entry off it, and every route must share it.
PAY_TO=

# GoPlausible facilitator — required by the challenge, same URL on both networks.
FACILITATOR_URL=https://facilitator.goplausible.xyz

PRICE_DRAW=$0.01
PRICE_SEAL=$0.001

# ─── On-chain anchoring ───────────────────────────────────────────────────
# The beacon only retains a round for ~1512 rounds (~70 min). Anchoring writes
# each revealed result into a transaction note so the proof outlives that
# window. Costs 0.001 ALGO per draw; the account needs a small ALGO balance.
ANCHOR_ENABLED=true
ANCHOR_MNEMONIC=

# ─── Storage ──────────────────────────────────────────────────────────────
# Required in production. Without it the service falls back to memory and
# loses every verification link on restart.
DATABASE_URL=
DATABASE_SSL=false
# DATABASE_POOL_MAX=10

# ─── Draw parameters ──────────────────────────────────────────────────────
# Minimum rounds between sealing and the deciding round, rounded up to the next
# multiple of 8 (the only rounds the beacon publishes). Higher is safer.
COMMIT_LEAD_ROUNDS=16
MAX_PARTICIPANTS=10000
