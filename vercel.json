{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo 'no static build - the API renders every page'",
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
